{
  "name": "lenssort-ai",
  "description": "Local-first AI photo folder classification with explainable results and human correction.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Old-Doggy/lenssort-ai.git"
  },
  "homepage": "https://github.com/Old-Doggy/lenssort-ai#readme",
  "bugs": {
    "url": "https://github.com/Old-Doggy/lenssort-ai/issues"
  },
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup:models": "node tools/setup-model-assets.js",
    "setup:vision": "node tools/setup-vision-model.js --install-ollama",
    "verify:models": "node tools/verify-model-assets.js",
    "doctor": "node tools/doctor.js",
    "test:core": "node --test tools/verify-asset-install.test.js tools/verify-model-lifecycle.test.js tools/verify-person-presence-review.test.js tools/verify-vision-output.test.js tools/verify-vision-policy.test.js tools/verify-vision-review.test.js",
    "test:all": "node tools/run-unit-tests.js",
    "verify:folder": "node tools/verify-folder-sorter.js",
    "verify:output-deletion": "node tools/verify-output-deletion.js",
    "start:folder": "node tools/run-folder-sorter.js",
    "start:control": "node tools/start-control-server.js",
    "verify:control": "node tools/verify-control-api.js",
    "verify:quick-actions": "node tools/verify-quick-actions.js",
    "build:p1-failure-set": "node tools/build-p1-failure-set.js",
    "benchmark:p2-aesthetic": "node tools/benchmark-p2-aesthetic.js",
    "report:p2-model-selection": "node tools/build-p2-model-selection-report.js",
    "verify:model-evidence": "node tools/verify-model-evidence.js",
    "verify:folder-classification": "node tools/verify-folder-classification.js",
    "verify:p3-failure-regression": "node tools/verify-p3-failure-regression.js",
    "report:p3-evidence": "node tools/build-p3-evidence-report.js",
    "report:next-readiness": "node tools/build-next-stage-readiness.js",
    "inspect:p2-model-candidates": "node tools/inspect-p2-model-candidates.js",
    "verify:demo": "node tools/verify-demo-video.js",
    "verify:public-eval-policy": "node tools/verify-public-eval-policy.js",
    "build:open-images-candidates": "node tools/build-open-images-candidates.js",
    "verify:open-images-candidates": "node tools/verify-open-images-candidates.js",
    "download:open-images-candidates": "node tools/download-open-images-candidates.js",
    "verify:public-review": "node tools/verify-public-review.js",
    "verify:review-api": "node tools/verify-review-api.js",
    "verify:f5-review-preflight": "node tools/verify-f5-review-preflight.js",
    "generate:f5-review-sheets": "node tools/generate-f5-review-contact-sheets.js",
    "apply:f5-assisted-review": "node tools/apply-f5-assisted-review.js",
    "verify:f6b-power-condition": "node tools/verify-f6b-power-condition.js",
    "record:f7-login-boundary": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/record-f7-login-trigger-boundary.ps1",
    "verify:gpus": "node tools/verify-gpu-devices.js",
    "benchmark:devices": "node tools/benchmark-folder-devices.js --limit=20",
    "evaluate:labels": "node tools/evaluate-folder-labels.js",
    "verify:stability": "node tools/verify-folder-stability.js --source-limit=20 --copies=2 --backends=cpu,npu",
    "verify:long-batch": "node tools/verify-long-batch.js --source-limit=20 --copies=50 --backends=cpu,npu --sustained-ms=300000",
    "measure:dgpu-power": "node tools/measure-dgpu-power.js",
    "verify:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/verify-startup.ps1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "onnxruntime-node": "^1.21.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
